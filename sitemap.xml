<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign pages = site.html_pages | sort: "url" %}
{% for p in pages %}{% unless p.sitemap == false or p.name == "404.html" or p.url contains "/research/" %}
  <url>
    <loc>{{ p.url | replace: "index.html", "" | absolute_url }}</loc>
  </url>
{% endunless %}{% endfor %}
</urlset>
